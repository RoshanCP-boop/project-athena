# Template for ~/sage/.env. Copy to .env and fill in your values.
# Don't commit your actual .env — it has secrets.

# --- Cloud LLM / STT / TTS (Groq) -----------------------------------------
# Used only when online (deep-think) mode is toggled on. Get a free API
# key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_VOICE=austin

# --- Local Piper TTS ------------------------------------------------------
# Used when online mode is OFF. Download voices from
# https://huggingface.co/rhasspy/piper-voices/tree/main/en
PIPER_MODEL=~/sage/vendor/piper-voices/en_US-ryan-medium.onnx

# --- Wake word ------------------------------------------------------------
# Built-in name (hey_jarvis, alexa, hey_mycroft, ...) or absolute path to
# a custom .onnx file. Threshold 0.0 - 1.0; lower = more sensitive (more
# false triggers), higher = stricter.
SAGE_WAKE_MODEL=hey_jarvis
SAGE_WAKE_THRESHOLD=0.5

# Optional: log any wake-word score above this floor (helps tune threshold).
# SAGE_WAKE_DIAG_FLOOR=0.20

# Optional: how long a silent input stream is tolerated before recreate.
# Leave at default 4.0; raise only if you've applied the CPUAffinity fix.
# SAGE_STREAM_DEAD_AFTER=4.0

# Optional: PortAudio input buffer in seconds. 0.5 default is a good
# trade-off for a USB 1.1 mic. Lower = lower latency, less CPU headroom.
# SAGE_INPUT_LATENCY=0.5
